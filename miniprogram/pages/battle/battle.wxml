<!--pages/battle/battle.wxml - 战斗界面-->
<view class="battle-container">
  <!-- 顶部信息 -->
  <view class="battle-header">
    <view class="battle-info">
      <text class="enemy-name">{{target.name}}</text>
      <text class="battle-round">第 {{round}} 回合</text>
    </view>
    <view class="difficulty-scale">难度：{{difficultyScale}}%</view>
  </view>

  <!-- 兵种克制提示 -->
  <view wx:if="{{counterAdvantages.length > 0 || counterDisadvantages.length > 0}}" class="counter-tip">
    <view wx:if="{{counterAdvantages.length > 0}}" class="counter-advantage">
      <text>✅ {{counterAdvantages[0]}}</text>
    </view>
    <view wx:if="{{counterDisadvantages.length > 0}}" class="counter-disadvantage">
      <text>⚠️ {{counterDisadvantages[0]}}</text>
    </view>
  </view>

  <!-- 敌方区域 -->
  <view class="enemy-zone">
    <view class="side-title">敌方</view>
    <view class="enemy-units">
      <view wx:for="{{enemyUnits}}" wx:key="uid" class="enemy-unit {{item.hp <= 0 ? 'defeated' : ''}} {{item.isAttacking ? 'attacking' : ''}}">
        <text class="unit-icon">{{item.icon}}</text>
        <view class="hp-bar">
          <view class="hp-fill" style="width: {{item.hp / item.maxHp * 100}}%"></view>
        </view>
        <text class="unit-hp">{{item.hp}}/{{item.maxHp}}</text>
        <view wx:if="{{item.shield}}" class="shield-effect">🛡️</view>
      </view>
    </view>
  </view>

  <!-- 战斗效果区域 -->
  <view class="battle-effect">
    <view wx:if="{{battleEffect.show}}" class="effect {{battleEffect.type}}">
      <text class="effect-icon">{{battleEffect.icon}}</text>
      <text class="effect-text">{{battleEffect.text}}</text>
    </view>
  </view>

  <!-- 我方区域 -->
  <view class="player-zone">
    <view class="side-title">我方</view>
    <view class="player-units">
      <view wx:for="{{playerUnits}}" wx:key="uid" class="player-unit {{item.hp <= 0 ? 'defeated' : ''}} {{item.isAttacking ? 'attacking' : ''}}">
        <text class="unit-icon">{{item.icon}}</text>
        <view class="hp-bar">
          <view class="hp-fill player" style="width: {{item.hp / item.maxHp * 100}}%"></view>
        </view>
        <text class="unit-hp">{{item.hp}}/{{item.maxHp}}</text>
        <view wx:if="{{item.shield}}" class="shield-effect">🛡️</view>
      </view>
    </view>
  </view>

  <!-- 战斗日志 -->
  <view class="battle-log">
    <view class="log-title">📜 战斗日志</view>
    <scroll-view scroll-y class="log-content" scroll-into-view="{{logScrollId}}">
      <view wx:for="{{battleLog}}" wx:key="id" id="log-{{index}}" class="log-entry {{item.type}}">
        <text class="log-icon">{{item.icon}}</text>
        <text class="log-text">{{item.text}}</text>
      </view>
    </scroll-view>
  </view>

  <!-- 底部按钮 -->
  <view class="battle-actions">
    <button class="btn-skip" bindtap="skipBattle">⏩ 跳过战斗</button>
  </view>
</view>
