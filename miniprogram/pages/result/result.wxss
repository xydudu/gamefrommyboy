/* pages/result/result.wxss */
.result-container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 16px;
  background: linear-gradient(180deg, #1a1a2e 0%, #0f3460 100%);
}

.result-card {
  background: rgba(30, 30, 50, 0.8);
  border: 2px solid rgba(255, 255, 255, 0.1);
  border-radius: 24px;
  padding: 32px;
  width: 100%;
  max-width: 400px;
  text-align: center;
  margin-bottom: 24px;
}

.result-card.victory {
  border-color: #00ff88;
  box-shadow: 0 0 30px rgba(0, 255, 136, 0.3);
}

.result-card.defeat {
  border-color: #ff2d55;
  box-shadow: 0 0 30px rgba(255, 45, 85, 0.3);
}

.result-icon {
  font-size: 64px;
  margin-bottom: 16px;
}

.result-title {
  font-size: 32px;
  font-weight: bold;
  margin-bottom: 8px;
}

.result-card.victory .result-title {
  color: #00ff88;
}

.result-card.defeat .result-title {
  color: #ff2d55;
}

.result-subtitle {
  font-size: 14px;
  color: rgba(255, 255, 255, 0.7);
  margin-bottom: 24px;
}

.result-stats {
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-bottom: 24px;
}

.stat-box {
  background: rgba(255, 255, 255, 0.05);
  padding: 16px;
  border-radius: 12px;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.stat-label {
  font-size: 12px;
  color: rgba(255, 255, 255, 0.6);
}

.stat-value {
  font-size: 24px;
  font-weight: bold;
}

.stat-value.gold {
  color: #ffcc00;
}

.stat-value.warning {
  color: #ff2d55;
  animation: pulse 1s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

.game-over-box {
  background: rgba(255, 45, 85, 0.2);
  border: 1px solid #ff2d55;
  border-radius: 12px;
  padding: 16px;
  margin-top: 16px;
}

.game-over-title {
  font-size: 20px;
  font-weight: bold;
  color: #ff2d55;
  display: block;
  margin-bottom: 8px;
}

.game-over-reason {
  font-size: 14px;
  color: rgba(255, 255, 255, 0.8);
}

.result-actions {
  width: 100%;
  max-width: 400px;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.btn-primary {
  background: linear-gradient(135deg, #00d4ff, #00ffcc);
  color: #000;
  border: none;
  border-radius: 12px;
  padding: 16px 32px;
  font-weight: bold;
  font-size: 18px;
}

.btn-secondary {
  background: rgba(255, 255, 255, 0.1);
  color: #fff;
  border: 1px solid rgba(255, 255, 255, 0.3);
  border-radius: 12px;
  padding: 16px 32px;
  font-size: 16px;
}
