/* pages/result/result.wxss */
.result-container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 16px;
  background: linear-gradient(180deg, #1a1a2e 0%, #0f3460 100%);
}

/* 弹窗通用样式 */
.game-over-modal, .victory-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.8);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 1000;
  animation: fadeIn 0.3s ease-out;
}

.modal-content {
  background: rgba(30, 30, 50, 0.95);
  border: 2px solid rgba(255, 255, 255, 0.1);
  border-radius: 24px;
  padding: 32px;
  width: 90%;
  max-width: 400px;
  text-align: center;
  animation: slideUp 0.3s ease-out;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes slideUp {
  from { transform: translateY(50px); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}

/* 游戏结束样式 */
.game-over-icon {
  font-size: 64px;
  margin-bottom: 16px;
}

.game-over-title {
  font-size: 28px;
  font-weight: bold;
  color: #ff2d55;
  margin-bottom: 8px;
}

.game-over-reason {
  font-size: 16px;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 24px;
}

/* 通关样式 */
.victory-icon {
  font-size: 64px;
  margin-bottom: 16px;
  animation: glow 1s ease-in-out infinite;
}

.victory-title {
  font-size: 28px;
  font-weight: bold;
  color: #ffcc00;
  margin-bottom: 8px;
}

.victory-subtitle {
  font-size: 14px;
  color: rgba(255, 255, 255, 0.7);
  margin-bottom: 24px;
}

@keyframes glow {
  0%, 100% { text-shadow: 0 0 10px rgba(255, 204, 0, 0.5); }
  50% { text-shadow: 0 0 30px rgba(255, 204, 0, 0.8); }
}

/* 结果卡片 */
.result-card {
  background: rgba(30, 30, 50, 0.8);
  border: 2px solid rgba(255, 255, 255, 0.1);
  border-radius: 24px;
  padding: 32px;
  width: 90%;
  max-width: 400px;
  text-align: center;
  margin-bottom: 24px;
}

.result-card.victory {
  border-color: #00ff88;
  box-shadow: 0 0 30px rgba(0, 255, 136, 0.3);
}

.result-card.defeat {
  border-color: #ff2d55;
  box-shadow: 0 0 30px rgba(255, 45, 85, 0.3);
}

.result-icon {
  font-size: 64px;
  margin-bottom: 16px;
}

.result-title {
  font-size: 32px;
  font-weight: bold;
  margin-bottom: 8px;
}

.result-card.victory .result-title {
  color: #00ff88;
}

.result-card.defeat .result-title {
  color: #ff2d55;
}

.result-subtitle {
  font-size: 14px;
  color: rgba(255, 255, 255, 0.7);
  margin-bottom: 24px;
}

/* 统计框 */
.result-stats, .game-over-stats, .victory-stats {
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-bottom: 24px;
}

.stat-box {
  background: rgba(255, 255, 255, 0.05);
  padding: 16px;
  border-radius: 12px;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.stat-label {
  font-size: 12px;
  color: rgba(255, 255, 255, 0.6);
}

.stat-value {
  font-size: 24px;
  font-weight: bold;
}

.stat-value.gold {
  color: #ffcc00;
}

.stat-value.damage {
  color: #ff2d55;
}

.stat-value.warning {
  color: #ff2d55;
  animation: pulse 1s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

/* 最终 BOSS 提示 */
.final-boss-tip {
  background: rgba(255, 45, 85, 0.15);
  border: 1px solid rgba(255, 45, 85, 0.3);
  border-radius: 12px;
  padding: 12px 16px;
  margin-bottom: 24px;
  display: flex;
  align-items: center;
  gap: 8px;
}

.tip-icon {
  font-size: 20px;
}

.tip-text {
  font-size: 13px;
  color: rgba(255, 255, 255, 0.9);
}

/* 按钮 */
.game-over-actions, .victory-actions, .result-actions {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.btn-primary {
  background: linear-gradient(135deg, #00d4ff, #00ffcc);
  color: #000;
  border: none;
  border-radius: 12px;
  padding: 16px 32px;
  font-weight: bold;
  font-size: 18px;
}

.btn-secondary {
  background: rgba(255, 255, 255, 0.1);
  color: #fff;
  border: 1px solid rgba(255, 255, 255, 0.3);
  border-radius: 12px;
  padding: 16px 32px;
  font-size: 16px;
}
