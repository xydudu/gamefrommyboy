/* components/unit-card/unit-card.wxss */
.unit-card {
  background: rgba(255, 255, 255, 0.05);
  border: 2px solid rgba(255, 255, 255, 0.1);
  border-radius: 12px;
  padding: 12px;
  position: relative;
  transition: all 0.3s;
  min-width: 120px;
}

.unit-card:active {
  transform: scale(0.95);
}

.unit-card.player {
  border-color: rgba(0, 212, 255, 0.5);
  background: rgba(0, 212, 255, 0.1);
}

.unit-card.enemy {
  border-color: rgba(255, 45, 85, 0.5);
  background: rgba(255, 45, 85, 0.1);
}

.unit-card.disabled {
  opacity: 0.5;
  filter: grayscale(50%);
}

.card-header {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 8px;
}

.unit-icon {
  font-size: 28px;
}

.unit-name {
  font-size: 14px;
  font-weight: bold;
}

.card-stats {
  display: flex;
  gap: 12px;
  margin-bottom: 8px;
}

.stat-item {
  display: flex;
  align-items: center;
  gap: 4px;
}

.stat-icon {
  font-size: 12px;
}

.stat-value {
  font-size: 12px;
  font-weight: bold;
}

.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.cost {
  font-size: 12px;
  color: #ffcc00;
}

.level {
  font-size: 10px;
  background: rgba(0, 212, 255, 0.2);
  color: #00d4ff;
  padding: 2px 6px;
  border-radius: 4px;
}

.lock-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
  border-radius: 12px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: 8px;
}

.lock-icon {
  font-size: 24px;
}

.unlock-cost {
  font-size: 12px;
  color: #ffcc00;
}
